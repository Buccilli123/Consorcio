# Plantilla de variables de entorno. Copiar a .env y completar con valores locales.
# Este archivo se versiona: NO poner credenciales reales acá.
# .env no se versiona (ver .gitignore). Roles y permisos: scripts/db/ y ADR-005.

# App: rol consorcio_app, que solo lee y escribe filas (sin DDL ni TRUNCATE).
DATABASE_URL="postgresql://consorcio_app:CONTRASENA_APP@localhost:5432/consorcio_dev?schema=public"

# Migraciones (Prisma CLI): rol consorcio_migrator, dueño del esquema.
MIGRATE_DATABASE_URL="postgresql://consorcio_migrator:CONTRASENA_MIGRADOR@localhost:5432/consorcio_dev?schema=public"
# Base auxiliar que usa "prisma migrate dev"; Prisma la vacía en cada uso.
SHADOW_DATABASE_URL="postgresql://consorcio_migrator:CONTRASENA_MIGRADOR@localhost:5432/consorcio_shadow?schema=public"

# Tests de integración. El nombre de la base DEBE terminar en _test:
# los tests se niegan a correr contra cualquier otra.
TEST_DATABASE_URL="postgresql://consorcio_app:CONTRASENA_APP@localhost:5432/consorcio_test?schema=public"
TEST_MIGRATE_DATABASE_URL="postgresql://consorcio_migrator:CONTRASENA_MIGRADOR@localhost:5432/consorcio_test?schema=public"

# Producción: se define en la etapa de despliegue, en el servidor, con roles y
# contraseñas propios. Nunca reutilizar estas credenciales de desarrollo.
